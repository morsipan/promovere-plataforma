# ============================================================
# Promovêre — Variables de Entorno (Payload CMS 3.0 + Supabase)
# ============================================================

# Conexión a la base de datos PostgreSQL de Supabase.
# Obtené esta cadena desde tu Dashboard de Supabase en Project Settings -> Database -> Connection string (URI):
# - Modo Transaccional (Recomendado para Serverless/Next.js): puerto 6543 (con ?pgbouncer=true)
# - Modo Sesión / Directo: puerto 5432
# Formato: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URI=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Clave secreta de Payload CMS para firmar cookies y tokens JWT de sesión (mínimo 32 caracteres)
PAYLOAD_SECRET=promovere_payload_super_secret_session_key_2026_production

# URL del servidor Next.js
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
