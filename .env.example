# ============================================================
# Promovêre — Variables de Entorno (Payload CMS 3.0 + Supabase)
# ============================================================

# Conexión a la base de datos PostgreSQL de Supabase.
# Obtené esta cadena desde tu Dashboard de Supabase en Project Settings -> Database -> Connection string (URI) -> Pooling:
# - Modo Transaccional / Pooling (Requerido para Vercel Serverless / IPv4): puerto 6543
# Formato: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URI=postgresql://postgres.nfbutyeottopxphyykdh:your-password@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Clave secreta de Payload CMS para firmar cookies y tokens JWT de sesión (mínimo 32 caracteres)
PAYLOAD_SECRET=promovere_payload_super_secret_session_key_2026_production

# URL del servidor Next.js
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
